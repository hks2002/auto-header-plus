{
  "name": "auto-header-plus",
  "displayName": "Auto Header Plus",
  "description": "Auto add header to a new file or existing file",
  "publisher": "MerBleueAviation",
  "license": "MIT",
  "version": "1.6.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hks2002/auto-header-plus.git"
  },
  "scripts": {
    "compile": "cspell . && node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "lint": "eslint src --ext js",
    "spell-check": "cspell .",
    "pretest": "yarn run compile && yarn run lint",
    "test": "node ./src/test/runTest.js",
    "vscode:prepublish": "yarn run compile",
    "publish": "vsce publish --yarn --skip-duplicate",
    "package": "vsce package --yarn"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.7.1",
    "cspell": "^9.6.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "glob": "^11.0.3",
    "globals": "^17.0.0",
    "mocha": "^11.7.1"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "auto",
    "file",
    "header",
    "comments"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "auto-header-plus.addHeader",
        "title": "Add Header"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Auto Header Plus",
      "properties": {
        "auto-header-plus.enableAutoAddOnSave": {
          "order": 0,
          "type": "boolean",
          "default": true,
          "description": "%auto-header-plus.enableAutoAddOnSave%"
        },
        "auto-header-plus.enableAutoAddOnNew": {
          "order": 0,
          "type": "boolean",
          "default": false,
          "description": "%auto-header-plus.enableAutoAddOnNew%"
        },
        "auto-header-plus.allowCreateTimeDiff": {
          "order": 2,
          "type": "boolean",
          "default": true,
          "description": "%auto-header-plus.allowCreateTimeDiff%"
        },
        "auto-header-plus.dateFormat": {
          "order": 3,
          "type": "string",
          "default": "YYYY-MM-DD HH:mm:ss",
          "description": "%auto-header-plus.dateFormat%"
        },
        "auto-header-plus.pathContainsWorkspaceFolder": {
          "order": 4,
          "type": "boolean",
          "default": true,
          "description": "%auto-header-plus.pathContainsWorkspaceFolder%"
        },
        "auto-header-plus.commandTimesOut": {
          "order": 5,
          "type": "integer",
          "default": 5000,
          "maximum": 10000,
          "description": "%auto-header-plus.commandTimesOut%"
        },
        "auto-header-plus.commentElements": {
          "order": 6,
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Author",
            "CreatedDate",
            "LastEditors",
            "LastEditDate",
            "FilePath",
            "CopyRight"
          ],
          "markdownDescription": "%auto-header-plus.commentElements%"
        },
        "auto-header-plus.commentElementsValue": {
          "order": 7,
          "type": "object",
          "default": {
            "Author": "${git config user.name}<${git config user.email}>",
            "CreatedDate": "CREATED_DATE",
            "LastEditors": "${git config user.name}<${git config user.email}>",
            "LastEditDate": "MODIFIED_DATE",
            "FilePath": "RELATIVE_PATH",
            "CopyRight": "MerBleueAviation"
          },
          "properties": {
            "Author": {
              "type": "string",
              "default": "${git config user.name}<${git config user.email}>",
              "description": "%auto-header-plus.Author%"
            },
            "CreatedDate": {
              "type": "string",
              "default": "CREATED_DATE",
              "enum": [
                "CREATED_DATE",
                "MODIFIED_DATE"
              ]
            },
            "LastEditors": {
              "type": "string",
              "default": "${git config user.name}<${git config user.email}>"
            },
            "LastEditDate": {
              "type": "string",
              "default": "MODIFIED_DATE",
              "enum": [
                "CREATED_DATE",
                "MODIFIED_DATE"
              ]
            },
            "FilePath": {
              "type": "string",
              "default": "RELATIVE_PATH",
              "enum": [
                "FULL_PATH",
                "RELATIVE_PATH",
                "SHORTNAME_PATH"
              ]
            },
            "Description": {
              "type": "string",
              "default": ""
            },
            "CopyRight": {
              "type": "string",
              "default": ""
            }
          },
          "additionalProperties": false,
          "markdownDescription": "%auto-header-plus.commentElementsValue%"
        },
        "auto-header-plus.customCommentElementsValue": {
          "order": 8,
          "type": "object",
          "default": {
            "YourCustomCommentElement1": ""
          },
          "properties": {
            "YourCustomCommentElement1": {
              "type": "string",
              "default": ""
            }
          },
          "additionalProperties": true,
          "markdownDescription": "%auto-header-plus.customCommentElementsValue%"
        },
        "auto-header-plus.style.0": {
          "order": 9,
          "type": "object",
          "default": {
            "enable": true,
            "applyTo": "c|cpp|h|hpp|cs|java|js|ts|go|php|rs",
            "firstLineStart": "/**",
            "firstLineMiddle": "*",
            "firstLineEnd": "*",
            "middleLineStart": " * ",
            "commentElementPrefix": "@",
            "commentElementSuffix": ": ",
            "middleLineEnd": "*",
            "lastLineStart": " *",
            "lastLineMiddle": "*",
            "lastLineEnd": "**/",
            "commentElementWidth": 25,
            "lineWidth": 80
          },
          "properties": {
            "enable": {
              "type": "boolean",
              "default": true,
              "description": "%auto-header-plus.enable%"
            },
            "applyTo": {
              "type": "string",
